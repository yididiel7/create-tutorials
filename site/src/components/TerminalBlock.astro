---
interface Props {
  command: string;
}

const { command } = Astro.props;
---

<div class="my-4 rounded-lg border border-arch-border bg-arch-terminal overflow-hidden font-mono text-sm">
  <div class="px-4 py-2 bg-arch-surface border-b border-arch-border flex items-center gap-2">
    <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
    <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
    <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
    <span class="text-xs text-arch-muted ml-2">bash</span>
  </div>
  <div class="p-4 text-arch-text flex items-start gap-2 overflow-x-auto">
    <span class="text-arch-cyan select-none">$</span>
    <code>{command}</code>
  </div>
</div>